{
	"name": "@nvisy/mcp",
	"version": "0.44.0",
	"description": "Model Context Protocol server for the Nvisy multimodal redaction platform",
	"type": "module",
	"private": false,
	"keywords": [
		"nvisy",
		"mcp",
		"model-context-protocol",
		"ai",
		"llm",
		"agent",
		"tools",
		"typescript",
		"redaction",
		"anonymization",
		"pii",
		"phi",
		"data-privacy",
		"document-processing"
	],
	"author": "Nvisy <support@nvisy.com>",
	"license": "MIT",
	"homepage": "https://github.com/nvisycom/mcp#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nvisycom/mcp.git"
	},
	"bugs": {
		"url": "https://github.com/nvisycom/mcp/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"nvisy-mcp": "./dist/stdio.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.txt",
		"CHANGELOG.md",
		"CONTRIBUTING.md"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"dev": "tsdown --watch",
		"start": "node dist/stdio.js",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"clean": "rimraf dist",
		"inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js",
		"prepublishOnly": "npm run clean && npm run build && npm run test",
		"release": "npm run prepublishOnly && npm publish"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@nvisy/sdk": "^0.44.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"license-checker-rseidelsohn": "^5.0.1",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
